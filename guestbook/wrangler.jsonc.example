{
  "name": "relationship-galaxy-guestbook",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://xizili.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "relationship-galaxy-guestbook",
    "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": false }
}
